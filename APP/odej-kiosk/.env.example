# Racine des médias sur le CDN. Sans cette variable, l'application cherche les médias dans /media/ du site.
# Sur Netlify : à régler dans les variables d'environnement une fois le CDN publié (ce n'est pas un secret).
# VITE_MEDIA_BASE_URL=https://odej-media.pages.dev/

# Clé ArcGIS du fond satellite, facultative (D3). À restreindre au domaine dans la console du fournisseur.
# VITE_SATELLITE_KEY=
