{
  "name": "odej-bejaia-kiosk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "predev": "node scripts/build-media-index.mjs && node scripts/build-details-index.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-media-index.mjs && node scripts/build-details-index.mjs",
    "build": "npm run validate:data && tsc -p tsconfig.json --noEmit && vite build",
    "postbuild": "node scripts/prune-media.mjs",
    "preview": "vite preview",
    "media:check": "node ../../tools/media/pipeline/check.mjs",
    "media:thumbs": "node ../../tools/media/pipeline/thumbs.mjs",
    "media:landing": "node ../../tools/media/pipeline/landing.mjs",
    "media:publish": "node ../../tools/media/pipeline/publish.mjs",
    "media:verify": "node ../../tools/media/pipeline/verify.mjs",
    "kiosk:pack": "node ../../tools/media/pipeline/kiosk-pack.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "validate:data": "node scripts/validate-data.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.1.0",
    "@fontsource/amiri": "^5.1.0",
    "@fontsource/marcellus": "^5.1.0",
    "maplibre-gl": "6.16.0",
    "qrcode-generator": "^1.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
