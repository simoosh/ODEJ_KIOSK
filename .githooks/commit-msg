#!/bin/sh
# Refuse les messages de commit avec une attribution (teamwork/README.md, section 3).
# Activé par `npm ci` dans APP/odej-kiosk (script prepare), ou à la main : git config core.hooksPath .githooks

if grep -v '^#' "$1" | grep -Eiq 'co-authored-by|generated with|noreply@anthropic\.com'; then
  echo "commit-msg: message refused: remove the attribution line." >&2
  echo "Refused words: Co-Authored-By, Generated with, noreply@anthropic.com" >&2
  exit 1
fi
